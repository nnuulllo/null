local function Color3ToTable(c)
    return {R = c.R, G = c.G, B = c.B}
end

local function TableToColor3(t)
    if typeof(t) == "table" and t.R and t.G and t.B then
        return Color3.new(t.R, t.G, t.B)
    end
    return Color3.fromRGB(255, 255, 255)
end

local function SerializeConfig()
    local data = {}
    for k, v in pairs(CONFIG) do
        if typeof(v) == "Color3" then
            data[k] = {__type = "Color3", value = Color3ToTable(v)}
        elseif typeof(v) == "EnumItem" then
            data[k] = {__type = "EnumItem", enumType = tostring(v.EnumType), name = v.Name}
        else
            data[k] = v
        end
    end
    return HttpService:JSONEncode(data)
end

local function RefreshUIComponents()
    for configKey, binding in pairs(UI_BINDINGS) do
        local val = CONFIG[configKey]
        if val ~= nil then
            binding.Set(val)
        end
    end
end

local function UpdateWorldVisuals()
    if CONFIG.WorldFogEnabled then
        Lighting.FogEnd = CONFIG.WorldFogDistance
    else
        Lighting.FogEnd = 1000000
    end

    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") then
            obj.Density = CONFIG.WorldAtmosphereEnabled and CONFIG.WorldAtmosphereDensity or 0
        end
    end
end

local function ApplyViewModelHiding(model, state)
    if model.Name == "FirstPerson" then return end
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Texture") or part:IsA("Decal") then
            if state then
                if part.Transparency < 1 and not part:GetAttribute("OriginalTransparency") then
                    part:SetAttribute("OriginalTransparency", part.Transparency)
                end
                part.Transparency = 1
            else
                local orig = part:GetAttribute("OriginalTransparency")
                if orig then
                    part.Transparency = orig
                end
            end
        end
    end
end

local function UpdateViewModelsVisibility()
    local vmFolder = workspace:FindFirstChild("ViewModels")
    if not vmFolder then return end
    for _, child in ipairs(vmFolder:GetChildren()) do
        ApplyViewModelHiding(child, CONFIG.HideOtherViewModels)
    end
end

local function SetupViewModelsListener()
    local function hookFolder(folder)
        folder.ChildAdded:Connect(function(child)
            if CONFIG.HideOtherViewModels then
                ApplyViewModelHiding(child, true)
            end
            child.DescendantAdded:Connect(function(descendant)
                if CONFIG.HideOtherViewModels then
                    if descendant:IsA("BasePart") or descendant:IsA("Texture") or descendant:IsA("Decal") then
                        if descendant.Transparency < 1 and not descendant:GetAttribute("OriginalTransparency") then
                            descendant:SetAttribute("OriginalTransparency", descendant.Transparency)
                        end
                        descendant.Transparency = 1
                    end
                end
            end)
        end)
        for _, child in ipairs(folder:GetChildren()) do
            if CONFIG.HideOtherViewModels then
                ApplyViewModelHiding(child, true)
            end
        end
    end

    local vmFolder = workspace:FindFirstChild("ViewModels")
    if vmFolder then
        hookFolder(vmFolder)
    end
    workspace.ChildAdded:Connect(function(child)
        if child.Name == "ViewModels" then
            hookFolder(child)
        end
    end)
end

SetupViewModelsListener()

local function DeserializeConfig(jsonStr)
    local success, data = pcall(function()
        return HttpService:JSONDecode(jsonStr)
    end)
    if not success or type(data) ~= "table" then return end

    for k, v in pairs(data) do
        if type(v) == "table" and v.__type then
            if v.__type == "Color3" then
                CONFIG[k] = TableToColor3(v.value)
            elseif v.__type == "EnumItem" then
                if v.enumType == "UserInputType" then
                    CONFIG[k] = Enum.UserInputType[v.name]
                elseif v.enumType == "KeyCode" then
                    CONFIG[k] = Enum.KeyCode[v.name]
                elseif v.enumType == "HighlightDepthMode" then
                    CONFIG[k] = Enum.HighlightDepthMode[v.name]
                end
            end
        else
            CONFIG[k] = v
        end
    end

    RefreshUIComponents()
    UpdateWorldVisuals()
    UpdateViewModelsVisibility()
end

local function SaveConfigFile(name)
    if writefile then
        local filePath = CONFIG_FOLDER .. "/" .. name .. ".json"
        pcall(function()
            writefile(filePath, SerializeConfig())
            writefile(LAST_CONFIG_FILE, name)
        end)
    end
end

local function LoadConfigFile(name)
    if readfile and isfile then
        local filePath = CONFIG_FOLDER .. "/" .. name .. ".json"
        if isfile(filePath) then
            pcall(function()
                local content = readfile(filePath)
                DeserializeConfig(content)
                writefile(LAST_CONFIG_FILE, name)
            end)
        end
    end
end

local function AutoLoadLastConfig()
    if readfile and isfile and isfile(LAST_CONFIG_FILE) then
        pcall(function()
            local lastName = readfile(LAST_CONFIG_FILE)
            if lastName and #lastName > 0 then
                LoadConfigFile(lastName)
            end
        end)
    end
end

local function DeleteConfigFile(name)
    if delfile then
        local filePath = CONFIG_FOLDER .. "/" .. name .. ".json"
        pcall(delfile, filePath)
        if readfile and isfile and isfile(LAST_CONFIG_FILE) then
            pcall(function()
                if readfile(LAST_CONFIG_FILE) == name then
                    delfile(LAST_CONFIG_FILE)
                end
            end)
        end
    end
end

local function GetConfigList()
    local list = {}
    if listfiles and isfolder and isfolder(CONFIG_FOLDER) then
        local success, files = pcall(listfiles, CONFIG_FOLDER)
        if success and files then
            for _, path in ipairs(files) do
                local filename = path:match("([^/\\]+)%.json$")
                if filename and filename ~= "last_config" then
                    table.insert(list, filename)
                end
            end
        end
    end
    return list
end

