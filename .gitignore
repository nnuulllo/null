--------------------------------------------------
-- 3-LAYER BOUNDED GRID CANVAS
--------------------------------------------------

local GridCanvas = Instance.new("Frame")
GridCanvas.Name = "GridCanvas"
GridCanvas.Size = UDim2.new(1, 0, 1, 0)
GridCanvas.BackgroundTransparency = 1
GridCanvas.ClipsDescendants = true
GridCanvas.ZIndex = 1
GridCanvas.Parent = BackgroundFrame

local LAYER_SPECS = {
    [1] = { count = 12, size = 4, dotAlpha = 0.8, lineBaseAlpha = 0.45, speed = 1.0, maxDist = 80, repelForce = 22 },
    [2] = { count = 14, size = 3, dotAlpha = 0.5, lineBaseAlpha = 0.28, speed = 0.6, maxDist = 68, repelForce = 12 },
    [3] = { count = 16, size = 2, dotAlpha = 0.25, lineBaseAlpha = 0.12, speed = 0.3, maxDist = 55, repelForce = 5 }
}

local layerNodes = {[1] = {}, [2] = {}, [3] = {}}
local layerLinePools = {[1] = {}, [2] = {}, [3] = {}}

for layerIdx = 1, 3 do
    local spec = LAYER_SPECS[layerIdx]
    for i = 1, spec.count do
        local dot = Instance.new("Frame")
        dot.Size = UDim2.fromOffset(spec.size, spec.size)
        dot.AnchorPoint = Vector2.new(0.5, 0.5)
        dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        dot.BackgroundTransparency = 1 - spec.dotAlpha
        dot.BorderSizePixel = 0
        dot.ZIndex = 1 + (4 - layerIdx)
        dot.Parent = GridCanvas

        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = dot

        table.insert(layerNodes[layerIdx], {
            Instance = dot,
            PosNorm = Vector2.new(math.random() * 0.92 + 0.04, math.random() * 0.92 + 0.04),
            Vel = Vector2.new((math.random() - 0.5) * 0.06 * spec.speed, (math.random() - 0.5) * 0.06 * spec.speed),
            Phase = math.random() * math.pi * 2,
            Curr2D = Vector2.new(0, 0)
        })
    end
end

local function GetLayerLine(layerIdx, index)
    local pool = layerLinePools[layerIdx]
    if not pool[index] then
        local line = Instance.new("Frame")
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        line.BorderSizePixel = 0
        line.ZIndex = 1
        line.Parent = GridCanvas
        pool[index] = line
    end
    return pool[index]
end

local floatTime = 0
RunService.RenderStepped:Connect(function(dt)
    if not MainFrame.Visible then return end
    floatTime = floatTime + dt

    local mousePos = UserInputService:GetMouseLocation()
    local frameAbsPos = BackgroundFrame.AbsolutePosition
    local frameAbsSize = BackgroundFrame.AbsoluteSize
    local relMouse = Vector2.new(mousePos.X - frameAbsPos.X, mousePos.Y - frameAbsPos.Y)

    for layerIdx = 1, 3 do
        local spec = LAYER_SPECS[layerIdx]
        local nodes = layerNodes[layerIdx]

        for i = 1, #nodes do
            local node = nodes[i]

            local px = node.PosNorm.X + node.Vel.X * dt
            local py = node.PosNorm.Y + node.Vel.Y * dt

            if px < 0.03 or px > 0.97 then node.Vel = Vector2.new(-node.Vel.X, node.Vel.Y) end
            if py < 0.03 or py > 0.97 then node.Vel = Vector2.new(node.Vel.X, -node.Vel.Y) end

            px = math.clamp(px, 0.02, 0.98)
            py = math.clamp(py, 0.02, 0.98)
            node.PosNorm = Vector2.new(px, py)

            local floatX = math.sin(floatTime * spec.speed + node.Phase) * (5 / layerIdx)
            local floatY = math.cos(floatTime * spec.speed * 0.8 + node.Phase) * (5 / layerIdx)

            local baseX = px * frameAbsSize.X + floatX
            local baseY = py * frameAbsSize.Y + floatY

            local dir = Vector2.new(baseX - relMouse.X, baseY - relMouse.Y)
            local distMouse = dir.Magnitude
            local offsetX, offsetY = 0, 0

            if distMouse < 90 and distMouse > 0 then
                local force = (1 - (distMouse / 90))^2 * spec.repelForce
                local norm = dir.Unit
                offsetX = norm.X * force
                offsetY = norm.Y * force
            end

            local targetX = math.clamp(baseX + offsetX, 4, frameAbsSize.X - 4)
            local targetY = math.clamp(baseY + offsetY, 4, frameAbsSize.Y - 4)

            node.Curr2D = node.Curr2D:Lerp(Vector2.new(targetX, targetY), math.clamp(dt * 12, 0, 1))
            node.Instance.Position = UDim2.fromOffset(node.Curr2D.X, node.Curr2D.Y)
        end

        local lineIndex = 0
        for i = 1, #nodes do
            for j = i + 1, #nodes do
                local p1 = nodes[i].Curr2D
                local p2 = nodes[j].Curr2D
                local diff = p2 - p1
                local dist = diff.Magnitude

                if dist < spec.maxDist then
                    lineIndex = lineIndex + 1
                    local line = GetLayerLine(layerIdx, lineIndex)

                    local midPoint = (p1 + p2) / 2
                    local angle = math.deg(math.atan2(diff.Y, diff.X))
                    local distAlpha = 1 - (dist / spec.maxDist)
                    local lineTrans = math.clamp(1 - (distAlpha * spec.lineBaseAlpha), 0.2, 1)

                    line.Visible = true
                    line.Size = UDim2.fromOffset(dist, 1)
                    line.Position = UDim2.fromOffset(midPoint.X, midPoint.Y)
                    line.Rotation = angle
                    line.BackgroundTransparency = lineTrans
                end
            end
        end

        local pool = layerLinePools[layerIdx]
        for k = lineIndex + 1, #pool do
            pool[k].Visible = false
        end
    end
end)

local function UpdateUIGradient()
    MainGradient.Enabled = CONFIG.UIGradientEnabled
    MainGradient.Rotation = CONFIG.UIGradientRotation
    MainGradient.Color = ColorSequence.new(CONFIG.UIGradientColor1, CONFIG.UIGradientColor2)
    BackgroundFrame.BackgroundTransparency = CONFIG.UITransparency
    if not CONFIG.UIGradientEnabled then
        BackgroundFrame.BackgroundColor3 = CONFIG.UIGradientColor1
    else
        BackgroundFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    end
end

