local function CreateToggle(parent, text, configKey, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 32)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    frame.BackgroundTransparency = 0.45
    frame.BorderSizePixel = 0
    frame.ZIndex = 6
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 200, 210)
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 7
    label.Parent = frame

    local switchTrack = Instance.new("TextButton")
    switchTrack.Size = UDim2.new(0, 42, 0, 20)
    switchTrack.Position = UDim2.new(1, -52, 0.5, -10)
    switchTrack.BackgroundColor3 = CONFIG[configKey] and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
    switchTrack.BackgroundTransparency = 0.1
    switchTrack.BorderSizePixel = 0
    switchTrack.Text = ""
    switchTrack.ZIndex = 7
    switchTrack.Parent = frame

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = switchTrack

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = CONFIG[configKey] and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BorderSizePixel = 0
    circle.ZIndex = 8
    circle.Parent = switchTrack

    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle

    local function UpdateToggleVisuals(state)
        local targetColor = state and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
        local targetPos = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)

        TweenService:Create(switchTrack, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(circle, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = targetPos}):Play()
    end

    switchTrack.MouseButton1Click:Connect(function()
        CONFIG[configKey] = not CONFIG[configKey]
        UpdateToggleVisuals(CONFIG[configKey])
        if callback then callback(CONFIG[configKey]) end
    end)

    UI_BINDINGS[configKey] = {
        Set = function(val)
            UpdateToggleVisuals(val)
            if callback then callback(val) end
        end
    }
end

local function CreateKeybind(parent, text, configKey)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 32)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    frame.BackgroundTransparency = 0.45
    frame.BorderSizePixel = 0
    frame.ZIndex = 6
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 200, 210)
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 7
    label.Parent = frame

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 100, 0, 20)
    button.Position = UDim2.new(1, -110, 0.5, -10)
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
    button.BackgroundTransparency = 0.3
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamBold
    button.Text = typeof(CONFIG[configKey]) == "EnumItem" and CONFIG[configKey].Name or "None"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 10
    button.ZIndex = 7
    button.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = button

    local listening = false
    button.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        button.Text = "Press key..."
        button.BackgroundColor3 = Color3.fromRGB(80, 80, 120)

        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                CONFIG[configKey] = input.KeyCode
                button.Text = input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                CONFIG[configKey] = input.UserInputType
                button.Text = input.UserInputType.Name
            end
            button.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
            listening = false
            conn:Disconnect()
        end)
    end)

    UI_BINDINGS[configKey] = {
        Set = function(val)
            if typeof(val) == "EnumItem" then
                button.Text = val.Name
            else
                button.Text = "None"
            end
        end
    }
end

local function CreateDropdown(parent, text, options, configKey)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 32)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    frame.BackgroundTransparency = 0.45
    frame.BorderSizePixel = 0
    frame.ZIndex = 6
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 200, 210)
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 7
    label.Parent = frame

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 90, 0, 20)
    button.Position = UDim2.new(1, -100, 0.5, -10)
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
    button.BackgroundTransparency = 0.3
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamBold
    button.Text = tostring(CONFIG[configKey])
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 10
    button.ZIndex = 7
    button.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = button

    local currentIndex = table.find(options, CONFIG[configKey]) or 1
    button.MouseButton1Click:Connect(function()
        currentIndex = (currentIndex % #options) + 1
        local selected = options[currentIndex]
        CONFIG[configKey] = selected
        button.Text = tostring(selected)
    end)

    UI_BINDINGS[configKey] = {
        Set = function(val)
            button.Text = tostring(val)
            currentIndex = table.find(options, val) or 1
        end
    }
end

local function CreateSlider(parent, text, min, max, configKey, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 42)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    frame.BackgroundTransparency = 0.45
    frame.BorderSizePixel = 0
    frame.ZIndex = 6
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local defaultVal = CONFIG[configKey]
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 18)
    label.Position = UDim2.new(0, 10, 0, 3)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = text .. ": " .. tostring(defaultVal)
    label.TextColor3 = Color3.fromRGB(200, 200, 210)
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 7
    label.Parent = frame

    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(1, -20, 0, 5)
    sliderBg.Position = UDim2.new(0, 10, 0, 26)
    sliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    sliderBg.BorderSizePixel = 0
    sliderBg.ZIndex = 7
    sliderBg.Parent = frame

    local sliderBgCorner = Instance.new("UICorner")
    sliderBgCorner.CornerRadius = UDim.new(1, 0)
    sliderBgCorner.Parent = sliderBg

    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new(math.clamp((defaultVal - min) / (max - min), 0, 1), 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
    sliderFill.BorderSizePixel = 0
    sliderFill.ZIndex = 8
    sliderFill.Parent = sliderBg

    local sliderFillCorner = Instance.new("UICorner")
    sliderFillCorner.CornerRadius = UDim.new(1, 0)
    sliderFillCorner.Parent = sliderFill

    local isSliding = false
    local function updateSlider(input)
        local posX = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local val = math.floor((min + (max - min) * posX) * 100) / 100
        sliderFill.Size = UDim2.new(posX, 0, 1, 0)
        label.Text = text .. ": " .. tostring(val)
        CONFIG[configKey] = val
        if callback then callback(val) end
    end

    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isSliding = true
            updateSlider(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isSliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isSliding = false
        end
    end)

    UI_BINDINGS[configKey] = {
        Set = function(val)
            local posX = math.clamp((val - min) / (max - min), 0, 1)
            sliderFill.Size = UDim2.new(posX, 0, 1, 0)
            label.Text = text .. ": " .. tostring(val)
            if callback then callback(val) end
        end
    }
end

local function CreateColorPicker(parent, text, configKey)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 32)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    frame.BackgroundTransparency = 0.45
    frame.BorderSizePixel = 0
    frame.ZIndex = 6
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 200, 210)
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 7
    label.Parent = frame

    local previewBtn = Instance.new("TextButton")
    previewBtn.Size = UDim2.new(0, 28, 0, 18)
    previewBtn.Position = UDim2.new(1, -38, 0.5, -9)
    previewBtn.BackgroundColor3 = CONFIG[configKey]
    previewBtn.BorderSizePixel = 0
    previewBtn.Text = ""
    previewBtn.ZIndex = 7
    previewBtn.Parent = frame

    local prevCorner = Instance.new("UICorner")
    prevCorner.CornerRadius = UDim.new(0, 4)
    prevCorner.Parent = previewBtn

    previewBtn.MouseButton1Click:Connect(function()
        currentActiveColorKey = configKey
        currentActivePreviewBtn = previewBtn
        
        local h, s, v = CONFIG[configKey]:ToHSV()
        pickerH, pickerS, pickerV = h, s, v
        
        CanvasGradientH.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(h, 1, 1))
        CanvasCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        HSCursor.Position = UDim2.new(h, 0, 0, 0)
        VSCursor.Position = UDim2.new(v, 0, 0, 0)
        
        local btnPos = previewBtn.AbsolutePosition
        local screenSize = Camera.ViewportSize
        local cpX = math.clamp(btnPos.X - 200, 10, screenSize.X - 200)
        local cpY = math.clamp(btnPos.Y, 10, screenSize.Y - 250)
        
        ColorPickerFrame.Position = UDim2.fromOffset(cpX, cpY)
        ColorPickerFrame.Visible = true
    end)

    UI_BINDINGS[configKey] = {
        Set = function(val)
            previewBtn.BackgroundColor3 = val
        end
    }
end

--------------------------------------------------
-- CONFIG SYSTEM UI
--------------------------------------------------

local function RefreshConfigListUI(container)
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Frame") and child.Name == "ConfigItemFrame" then
            child:Destroy()
        end
    end

    local configs = GetConfigList()
    for _, name in ipairs(configs) do
        local frame = Instance.new("Frame")
        frame.Name = "ConfigItemFrame"
        frame.Size = UDim2.new(1, -10, 0, 32)
        frame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
        frame.BackgroundTransparency = 0.45
        frame.BorderSizePixel = 0
        frame.ZIndex = 6
        frame.Parent = container

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.4, 0, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
