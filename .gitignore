local pickerH, pickerS, pickerV = 0, 1, 1

local function UpdateColorFromHSV()
    CanvasGradientH.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(pickerH, 1, 1))
    local color = Color3.fromHSV(pickerH, pickerS, pickerV)
    if currentActiveColorKey then
        CONFIG[currentActiveColorKey] = color
        if currentActiveColorKey:sub(1, 10) == "UIGradient" then
            UpdateUIGradient()
        end
    end
    if currentActivePreviewBtn then
        currentActivePreviewBtn.BackgroundColor3 = color
    end
end

local draggingCanvas, draggingHue, draggingVS = false, false, false

Canvas.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingCanvas = true end
end)
HueSlider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingHue = true end
end)
ValueSlider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingVS = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingCanvas = false
        draggingHue = false
        draggingVS = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if draggingCanvas then
            local x = math.clamp((input.Position.X - Canvas.AbsolutePosition.X) / Canvas.AbsoluteSize.X, 0, 1)
            local y = math.clamp((input.Position.Y - Canvas.AbsolutePosition.Y) / Canvas.AbsoluteSize.Y, 0, 1)
            pickerS = x
            pickerV = 1 - y
            CanvasCursor.Position = UDim2.new(x, 0, y, 0)
            UpdateColorFromHSV()
        elseif draggingHue then
            local x = math.clamp((input.Position.X - HueSlider.AbsolutePosition.X) / HueSlider.AbsoluteSize.X, 0, 1)
            pickerH = x
            HSCursor.Position = UDim2.new(x, 0, 0, 0)
            UpdateColorFromHSV()
        elseif draggingVS then
            local x = math.clamp((input.Position.X - ValueSlider.AbsolutePosition.X) / ValueSlider.AbsoluteSize.X, 0, 1)
            pickerV = x
            VSCursor.Position = UDim2.new(x, 0, 0, 0)
            UpdateColorFromHSV()
        end
    end
end)

CloseCPBtn.MouseButton1Click:Connect(function()
    ColorPickerFrame.Visible = false
end)

local cpDragging, cpDragStart, cpStartPos
CPTopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        cpDragging = true
        cpDragStart = input.Position
        cpStartPos = ColorPickerFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if cpDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - cpDragStart
        ColorPickerFrame.Position = UDim2.new(cpStartPos.X.Scale, cpStartPos.X.Offset + delta.X, cpStartPos.Y.Scale, cpStartPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        cpDragging = false
    end
end)

--------------------------------------------------
-- SMOOTH DRAGGING FOR MAIN WINDOW
--------------------------------------------------

local dragging = false
local dragStartPos = Vector3.new()
local frameStartPos = UDim2.new()
local targetPosition = MainFrame.Position

Topbar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStartPos = input.Position
        frameStartPos = MainFrame.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStartPos
        targetPosition = UDim2.new(
            frameStartPos.X.Scale,
            frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale,
            frameStartPos.Y.Offset + delta.Y
        )
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if MainFrame.Visible then
        MainFrame.Position = MainFrame.Position:Lerp(targetPosition, math.clamp(dt * 18, 0, 1))
    end
end)

local menuVisible = true
local isAnimating = false

local function ToggleMenu()
    if isAnimating then return end
    isAnimating = true
    
    if menuVisible then
        ColorPickerFrame.Visible = false
        TweenService:Create(MainScale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.8}):Play()
        local fadeTween = TweenService:Create(BackgroundFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {BackgroundTransparency = 1})
        fadeTween:Play()
        fadeTween.Completed:Wait()
        MainFrame.Visible = false
        menuVisible = false
    else
        MainFrame.Visible = true
        BackgroundFrame.BackgroundTransparency = CONFIG.UITransparency
        MainScale.Scale = 0.8
        TweenService:Create(MainScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        menuVisible = true
    end
    
    isAnimating = false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        ToggleMenu()
    end
    
    if CONFIG.AimEnabled and CONFIG.AimMode == "Toggle" then
        if typeof(CONFIG.AimKey) == "EnumItem" then
            if CONFIG.AimKey.EnumType == Enum.UserInputType and input.UserInputType == CONFIG.AimKey then
                aimToggleState = not aimToggleState
            elseif CONFIG.AimKey.EnumType == Enum.KeyCode and input.KeyCode == CONFIG.AimKey then
                aimToggleState = not aimToggleState
            end
        end
    end
end)

