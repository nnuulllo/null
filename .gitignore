local Sidebar = Instance.new("Frame")
Sidebar.Size = UDim2.new(0, 120, 1, -35)
Sidebar.Position = UDim2.new(0, 0, 0, 35)
Sidebar.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
Sidebar.BackgroundTransparency = 0.4
Sidebar.BorderSizePixel = 0
Sidebar.ZIndex = 5
Sidebar.Parent = BackgroundFrame

local TabContainer = Instance.new("Frame")
TabContainer.Size = UDim2.new(1, -130, 1, -45)
TabContainer.Position = UDim2.new(0, 125, 0, 40)
TabContainer.BackgroundTransparency = 1
TabContainer.ZIndex = 5
TabContainer.Parent = BackgroundFrame

local currentTabBtn = nil

local function CreateTabBtn(text, pos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 28)
    btn.Position = UDim2.new(0, 5, 0, pos)
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    btn.BackgroundTransparency = 0.35
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(180, 180, 200)
    btn.TextSize = 10
    btn.ZIndex = 6
    btn.Parent = Sidebar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseEnter:Connect(function()
        if currentTabBtn ~= btn then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(38, 38, 50), BackgroundTransparency = 0.2, TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        if currentTabBtn ~= btn then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 28, 36), BackgroundTransparency = 0.35, TextColor3 = Color3.fromRGB(180, 180, 200)}):Play()
        end
    end)

    return btn
end

local ESPMainBtn = CreateTabBtn("ESP MAIN", 8)
local ESPStyleBtn = CreateTabBtn("BOX & GRADIENT", 40)
local WorldBtn = CreateTabBtn("WORLD VISUALS", 72)
local ColorsBtn = CreateTabBtn("COLORS & TEXT", 104)
local AimTabBtn = CreateTabBtn("AIMBOT", 136)
local ConfigTabBtn = CreateTabBtn("CONFIGS", 168)

local function CreatePage()
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Color3.fromRGB(70, 70, 90)
    page.Visible = false
    page.ZIndex = 6
    page.Parent = TabContainer

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)
    layout.Parent = page

    return page
end

local ESPMainPage = CreatePage()
local ESPStylePage = CreatePage()
local WorldPage = CreatePage()
local ColorsPage = CreatePage()
local AimPage = CreatePage()
local ConfigPage = CreatePage()

local function SwitchTab(targetPage, targetBtn)
    ESPMainPage.Visible = false
    ESPStylePage.Visible = false
    WorldPage.Visible = false
    ColorsPage.Visible = false
    AimPage.Visible = false
    ConfigPage.Visible = false

    for _, child in ipairs(Sidebar:GetChildren()) do
        if child:IsA("TextButton") then
            TweenService:Create(child, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 28, 36), BackgroundTransparency = 0.35, TextColor3 = Color3.fromRGB(180, 180, 200)}):Play()
        end
    end

    currentTabBtn = targetBtn
    TweenService:Create(targetBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 120, 220), BackgroundTransparency = 0.15, TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    targetPage.Visible = true
end

ESPMainBtn.MouseButton1Click:Connect(function() SwitchTab(ESPMainPage, ESPMainBtn) end)
ESPStyleBtn.MouseButton1Click:Connect(function() SwitchTab(ESPStylePage, ESPStyleBtn) end)
WorldBtn.MouseButton1Click:Connect(function() SwitchTab(WorldPage, WorldBtn) end)
ColorsBtn.MouseButton1Click:Connect(function() SwitchTab(ColorsPage, ColorsBtn) end)
AimTabBtn.MouseButton1Click:Connect(function() SwitchTab(AimPage, AimTabBtn) end)
ConfigTabBtn.MouseButton1Click:Connect(function() SwitchTab(ConfigPage, ConfigTabBtn) end)

SwitchTab(ESPMainPage, ESPMainBtn)

