local aimToggleState = false

if makefolder and not isfolder(CONFIG_FOLDER) then
    pcall(makefolder, CONFIG_FOLDER)
end

local function Color3ToTable(c)
    return {R = c.R, G = c.G, B = c.B}
end

local function TableToColor3(t)
    if typeof(t) == "table" and t.R and t.G and t.B then
        return Color3.new(t.R, t.G, t.B)
    end
    return Color3.fromRGB(255, 255, 255)
end

local function SerializeConfig()
    local data = {}
    for k, v in pairs(CONFIG) do
        if typeof(v) == "Color3" then
            data[k] = {__type = "Color3", value = Color3ToTable(v)}
        elseif typeof(v) == "EnumItem" then
            data[k] = {__type = "EnumItem", enumType = tostring(v.EnumType), name = v.Name}
        else
            data[k] = v
        end
    end
    return HttpService:JSONEncode(data)
end

local function RefreshUIComponents()
    for configKey, binding in pairs(UI_BINDINGS) do
        local val = CONFIG[configKey]
        if val ~= nil then
            binding.Set(val)
        end
    end
end

local function DeserializeConfig(jsonStr)
    local success, data = pcall(function()
        return HttpService:JSONDecode(jsonStr)
    end)
    if not success or type(data) ~= "table" then return end

    for k, v in pairs(data) do
        if type(v) == "table" and v.__type then
            if v.__type == "Color3" then
                CONFIG[k] = TableToColor3(v.value)
            elseif v.__type == "EnumItem" then
                if v.enumType == "UserInputType" then
                    CONFIG[k] = Enum.UserInputType[v.name]
                elseif v.enumType == "KeyCode" then
                    CONFIG[k] = Enum.KeyCode[v.name]
                elseif v.enumType == "HighlightDepthMode" then
                    CONFIG[k] = Enum.HighlightDepthMode[v.name]
                end
            end
        else
            CONFIG[k] = v
        end
    end

    RefreshUIComponents()
end

local function SaveConfigFile(name)
    if writefile then
        local filePath = CONFIG_FOLDER .. "/" .. name .. ".json"
        pcall(function()
            writefile(filePath, SerializeConfig())
        end)
    end
end

local function LoadConfigFile(name)
    if readfile and isfile then
        local filePath = CONFIG_FOLDER .. "/" .. name .. ".json"
        if isfile(filePath) then
            pcall(function()
                local content = readfile(filePath)
                DeserializeConfig(content)
            end)
        end
    end
end

local function DeleteConfigFile(name)
    if delfile and isfile then
        local filePath = CONFIG_FOLDER .. "/" .. name .. ".json"
        if isfile(filePath) then
            pcall(function()
                delfile(filePath)
            end)
            task.wait(0.05)
        end
    end
end

local function GetConfigList()
    local list = {}
    if listfiles and isfolder and isfolder(CONFIG_FOLDER) then
        local success, files = pcall(listfiles, CONFIG_FOLDER)
        if success and files then
            for _, path in ipairs(files) do
                local filename = path:match("([^/\\]+)%.json$")
                if filename then
                    table.insert(list, filename)
                end
            end
        end
    end
    return list
end

